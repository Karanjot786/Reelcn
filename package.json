{
  "name": "reelcn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "studio": "pnpm --filter @reelcn/studio studio",
    "site": "pnpm --filter @reelcn/www dev",
    "site:build": "pnpm --filter @reelcn/www build",
    "typecheck": "tsc --noEmit && pnpm --filter @reelcn/www typecheck",
    "typecheck:user": "tsc -p tsconfig.user.json",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "node --test \"scripts/*.test.ts\" \"apps/www/lib/*.test.ts\"",
    "test:self": "pnpm --filter @reelcn/studio exec remotion still src/index.ts self-test ../../out/self-test.png --log=error",
    "registry:build": "node scripts/build-registry.ts",
    "check:drift": "test -z \"$(git status --porcelain -- registry.json apps/www/public)\" || (echo 'Generated files differ from the commit. Run pnpm registry:build and commit the result:' && git status --porcelain -- registry.json apps/www/public && exit 1)",
    "stills": "node scripts/stills.ts",
    "thumbs": "node scripts/thumbs.ts",
    "e2e": "node scripts/e2e.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@remotion/bundler": "catalog:",
    "@remotion/renderer": "catalog:",
    "@types/node": "24.13.4",
    "shadcn": "4.21.0",
    "typescript": "5.9.3"
  }
}
