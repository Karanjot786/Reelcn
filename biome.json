{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!skills/reelcn-motion/starters/*/target",
      "!out",
      "!docs",
      "!apps/www/public/r",
      "!registry.json",
      "!skills/reelcn-motion/tokens/tokens.ts",
      "!skills/reelcn-motion/tokens/tokens.js",
      "!skills/reelcn-motion/tokens/tokens.css",
      "!**/.next",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noArrayIndexKey": "off" }
    }
  }
}
